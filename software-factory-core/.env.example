# Plantilla del entorno. Se copia a .env y se completa la key a mano.
# .env está en .gitignore: la key no entra al repositorio.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Directorio del Estado Operativo: factory.db, trabajo/ y checkpointer/ cuelgan
# de aca. Si no se define, el estado vive en la carpeta hermana del repo
# (../software-factory-state), que es donde vive hoy.
# SOFTWARE_FACTORY_STATE_DIR=
